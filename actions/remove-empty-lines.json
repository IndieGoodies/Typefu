  "id": "remove-empty-lines",
  "kind": "javaScript",
  "name": "Remove Empty Lines",
  "output": "replace",
  "schemaVersion": 1,
  "script": "text.split(\"\\n\").filter(line => line.trim() !== \"\").join(\"\\n\")",
