{
  "author": "Typefu",
  "category": "markdown",
  "icon": "checklist",
  "id": "markdown-checklist",
  "kind": "javaScript",
  "name": "Checklist",
  "output": "replace",
  "schemaVersion": 1,
  "script": "text.split(\"\\n\").map(line => line.trim() ? \"- [ ] \" + line.replace(/^\\s*([-*+]|\\d+\\.)\\s+(\\[.\\]\\s+)?/, \"\") : line).join(\"\\n\")",
  "summary": "Turns lines into a Markdown checklist.",
  "version": "1.0.0"
}
