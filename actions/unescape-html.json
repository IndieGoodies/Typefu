{
  "author": "Typefu",
  "category": "developer",
  "icon": "chevron.left.slash.chevron.right",
  "id": "unescape-html",
  "kind": "javaScript",
  "name": "Unescape HTML",
  "output": "replace",
  "schemaVersion": 1,
  "script": "text.replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&quot;/g, \"\\\"\").replace(/&#39;/g, \"'\").replace(/&amp;/g, \"&\")",
  "summary": "Turns HTML entities back into characters.",
  "version": "1.0.0"
}
